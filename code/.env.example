# =============================================================================
# Unintended Memorization in LLMs - Experiment Configuration
# Reference model: Qwen/Qwen2.5-0.5B-Instruct
# =============================================================================

# --- Model & Reproducibility ---
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
SEED=42
DTYPE=float32

# --- Corpus & Canary Design (Fixed by Protocol) ---
NUM_RECORDS=256
RECORD_LENGTH_TOKENS=96
VOCAB_SIZE=32
NUM_CANARIES=24
CANARIES_PER_GROUP=6
SECRET_WORD_COUNT=4

# --- Background Prose Source (HuggingFace Datasets) ---
BACKGROUND_DATASET=Salesforce/wikitext
BACKGROUND_DATASET_CONFIG=wikitext-103-raw-v1
BACKGROUND_DATASET_SPLIT=train
MIN_BG_TOKENS=130

# --- LoRA Configuration (Attention + MLP) ---
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.0
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# --- Training Hyperparameters ---
NUM_EPOCHS=2
BATCH_SIZE=4
GRAD_ACCUM_STEPS=1
LEARNING_RATE=2e-4
LR_SCHEDULER_TYPE=constant
WARMUP_STEPS=0
WEIGHT_DECAY=0.0

# --- Evaluation & Decoding ---
MAX_NEW_TOKENS=24

# --- Storage & Google Colab / Drive ---
ARTIFACTS_DIR=artifacts
USE_GOOGLE_DRIVE=false
DRIVE_ARTIFACTS_DIR=/content/drive/MyDrive/unintended_memorization_artifacts
